# EEC — Enterprise Execution & Control Center
# Copia este archivo a .env y ajusta la ruta absoluta de la base de datos.
# Prisma resuelve URLs `file:` — usa ruta absoluta para evitar ambigüedades:
#   DATABASE_URL=file:/ruta/absoluta/a/este/proyecto/db/custom.db
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---- EEC V2 — seguridad (configuración OBLIGATORIA en despliegue) ----
EEC_OPERATOR_PASSWORD=cámbiame-contraseña-operador
EEC_SESSION_SECRET=secreto-hmac-aleatorio-largo
EEC_API_TOKEN=token-servicio-api
# Frontera INSTALADOR (opcional; sin URL la frontera informa "no disponible")
# EEC_INSTALLADOR_URL=https://instalador.interno
# EEC_INSTALLADOR_TOKEN=referencia-token
# Allowlists del adaptador de proceso local (rutas absolutas separadas por coma)
EEC_ALLOWED_WORKDIRS=/ruta/proyecto,/ruta/proyecto/agents
