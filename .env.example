# PANEL DE CONTROL — variables de entorno (contrato único de configuración)
#
# Estas MISMAS variables son las que el INSTALADOR genera en el .env.albra del
# despliegue contenedorizado (src/lib/albra/products/catalog.ts →
# PANEL_DEPLOYMENT_SOURCE) y las que exige deploy/docker-entrypoint.sh.
# Un solo contrato: no existen dos formas de configurar el PANEL.

# ── Base de datos (SQLite persistente) ──────────────────────────────
# Dev:   file:<ruta absoluta>/db/panel.db
# Docker: file:/app/data/panel.db (volumen panel-data)
# MSI:    %ProgramData%\ALBRA\db\panel.db (lo construye boot.js)
DATABASE_URL=file:/ruta/absoluta/a/este/proyecto/db/panel.db

# ── Seguridad del PANEL (OBLIGATORIAS en despliegue, fail-closed) ───
# Login del operador (cookie de sesión HMAC firmada con EEC_SESSION_SECRET)
EEC_OPERATOR_PASSWORD=cámbiame-contraseña-operador
# Secreto HMAC de las cookies de sesión (32+ bytes aleatorios)
EEC_SESSION_SECRET=secreto-hmac-aleatorio-largo
# Bearer exigido por las APIs del PANEL para clientes de servicio
EEC_API_TOKEN=token-servicio-api

# ── Modo de simulación (PRODUCCIÓN = 0) ────────────────────────────
# '0' (o ausente) = ejecución REAL. '1' = demo con providers simulados.
# El toggle humano persistido (system.simulation.toggle) prevalece sobre el env.
EEC_SIMULATION_MODE=0

# ── Puente REAL hacia el INSTALADOR (contrato EEC ops) ─────────────
# Cliente: src/lib/albra-bridge/ops-client.ts (POST /api/ops con Bearer,
# nonce, requestId, expiración ≤5min; GET /api/catalog y /api/runs/{id}).
# El token lo emite el INSTALADOR (SecretStore 'eec.ops.token'):
#   docker compose exec core bun scripts/print-ops-token.ts
#   o POST {INSTALADOR}/api/ops/token {confirm:true} (rotación, una lectura)
ALBRA_OPS_URL=http://127.0.0.1:3000
ALBRA_OPS_TOKEN=token-emitido-por-el-instalador

# ── Allowlists del adaptador de proceso local (opcional) ───────────
# Rutas absolutas separadas por coma que el runtime LOCAL_PROCESS puede usar
EEC_ALLOWED_WORKDIRS=/ruta/proyecto,/ruta/proyecto/agents
EEC_ALLOWED_EXECUTABLES=/usr/bin/bun,/usr/bin/node

# ── Cookie de sesión sin Secure (solo detrás de HTTP puro en dev) ──
# EEC_INSECURE_COOKIE=1

# ── Puerto del compose standalone (default 3000) ───────────────────
# PANEL_PORT=3000
