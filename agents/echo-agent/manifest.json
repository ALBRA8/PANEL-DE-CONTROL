{
  "contractVersion": "1.0.0",
  "identity": {
    "code": "ECO-01",
    "name": "Agente Eco (piloto E2E)",
    "version": "1.0.0",
    "owner": "ALBRA8",
    "description": "Agente determinista de prueba: proceso real separado del EEC; emite progreso NDJSON por stdout y resultado estructurado. No ejecuta órdenes arbitrarias."
  },
  "source": {
    "repo": "ALBRA8/PANEL-DE-CONTROL",
    "release": "agents/echo-agent@1.0.0"
  },
  "platform": {
    "os": "linux",
    "requirements": ["bun >= 1.0 (o node >= 18)"]
  },
  "runtime": {
    "type": "LOCAL_PROCESS",
    "executable": "bun",
    "args": ["agents/echo-agent/agent.mjs"],
    "workdir": "/home/z/my-project",
    "healthArgs": ["agents/echo-agent/agent.mjs", "--eec-health"]
  },
  "capabilities": [
    { "op": "echo.work", "description": "Trabajo determinista con progreso y resultado estructurado", "risk": "LOW", "requiresApproval": false },
    { "op": "echo.heavy", "description": "Trabajo prolongado (demostración de cancelación y timeout)", "risk": "MEDIUM", "requiresApproval": false }
  ],
  "config": [],
  "limits": {
    "timeoutMs": 60000,
    "maxRetries": 0,
    "idempotent": false
  },
  "health": {
    "intervalMs": 60000
  }
}
